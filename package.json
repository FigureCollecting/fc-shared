{
  "name": "@figurecollecting/fc-shared",
  "version": "1.7.0",
  "description": "Shared types, API client, and stores for Figure Collector frontends",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./utils/trace": {
      "types": "./dist/utils/trace.d.ts",
      "import": "./dist/utils/trace.mjs",
      "require": "./dist/utils/trace.js"
    },
    "./utils/sanitize": {
      "types": "./dist/utils/sanitize.d.ts",
      "import": "./dist/utils/sanitize.mjs",
      "require": "./dist/utils/sanitize.js"
    },
    "./utils/logger": {
      "types": "./dist/utils/logger.d.ts",
      "import": "./dist/utils/logger.mjs",
      "require": "./dist/utils/logger.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tsconfig.base.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FigureCollecting/fc-shared.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:esm",
    "build:esm": "esbuild src/index.ts src/utils/trace.ts src/utils/sanitize.ts src/utils/logger.ts src/types/index.ts --bundle --splitting --format=esm --platform=neutral --packages=external --outbase=src --outdir=dist --out-extension:.js=.mjs --sourcemap",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "axios": "^1.20.0",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace": "^2.11.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "jest": "^30.5.1",
    "jest-extended": "^7.0.0",
    "msw": "^2.15.0",
    "react": "^19.2.8",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "brace-expansion@2": "2.1.4",
    "js-yaml@3": "3.15.1"
  }
}
