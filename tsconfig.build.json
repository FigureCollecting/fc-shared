{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    // TS 6.0 deprecates moduleResolution "node" (node10, TS5107); "bundler" + commonjs is the documented upgrade path
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["tests", "**/*.test.ts"]
}
